root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Two trailing spaces are a Markdown line break, and an item nested under a
# "1. " list item must be indented three spaces, which no indent_size allows.
trim_trailing_whitespace = false
indent_size = unset

[{*.go,Makefile,*.mk}]
indent_style = tab

[*.{ps1,bat,cmd}]
end_of_line = crlf
